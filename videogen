async function main() {
  const args = process.argv.slice(2);
  const command = args[0];

  if (!command || command === 'help' || command === '--help' || command === '-h') {
    printHelp();
    return;
  }

  try {
    switch (command) {
      case 'bridge': {
        const sub = args[1];
        if (sub === 'status') {
          await bridge.status();
        } else {
          await bridge.ensureBridge();
        }
        break;
      }

      case 'doctor':
      case 'check': {
        const doctor = require('./engine/doctor');
        await doctor.runDoctor();
        break;
      }

      case 'board':
      case 'director': {
        const sbArg = args[1];
        if (!sbArg) {
          console.error('[!] Vui lòng cung cấp file storyboard: ./videogen board <storyboard.json> [--open]');
          process.exit(1);
        }
        const isOpen = args.includes('--open');
        const outArg = args.find(a => a.startsWith('--out='));
        const explicitOut = outArg ? outArg.split('=')[1].replace(/^["']|["']$/g, '') : null;

        const { path: sbPath, data: sb } = loadStoryboard(sbArg);
        board.generateBoard(sb, {
          storyboardPath: sbPath,
          out: explicitOut,
          open: isOpen
        });
        break;
      }

      case 'explainer': {
        const inputArg = args[1];
        if (!inputArg) {
          console.error('[!] Vui lòng cung cấp file transcript hoặc nội dung: ./videogen explainer <transcript.txt> [--title="..."] [--series="..."] [--ep="..."] [--ratio=16:9|9:16] [--out=storyboards/ep.json]');
          process.exit(1);
        }

        const explainer = require('./engine/explainer');
        let textContent = '';
        if (fs.existsSync(inputArg)) {
          textContent = fs.readFileSync(inputArg, 'utf8');
        } else {
          textContent = inputArg;
        }

        const titleArg = args.find(a => a.startsWith('--title='));
        const seriesArg = args.find(a => a.startsWith('--series='));
        const epArg = args.find(a => a.startsWith('--ep='));
        const ratioArg = args.find(a => a.startsWith('--ratio='));
        const scenesArg = args.find(a => a.startsWith('--scenes='));
        const outArg = args.find(a => a.startsWith('--out='));

        const title = titleArg ? titleArg.split('=')[1].replace(/^["']|["']$/g, '') : 'Explainer Episode';
        const seriesId = seriesArg ? seriesArg.split('=')[1].replace(/^["']|["']$/g, '') : 'explainer_series';
        const epId = epArg ? epArg.split('=')[1].replace(/^["']|["']$/g, '') : 'ep01';
        const aspectRatio = ratioArg ? ratioArg.split('=')[1].replace(/^["']|["']$/g, '') : '16:9';
        const scenesPath = scenesArg ? scenesArg.split('=')[1].replace(/^["']|["']$/g, '') : null;
        const outPath = outArg ? path.resolve(outArg.split('=')[1].replace(/^["']|["']$/g, '')) : path.join(config.STORYBOARDS_DIR, `${seriesId}_${epId}.json`);

        console.log(`=== BẮT ĐẦU CHUYỂN ĐỔI TRANSCRIPT SANG STORYBOARD EXPLAINER TỐI GIẢN ===`);
        const sb = explainer.createExplainerStoryboard({
          title,
          seriesId,
          episodeId: epId,
          transcriptText: textContent,
          aspectRatio,
          outputStoryboardPath: outPath,
          scenesPath
        });

        console.log(`[✓] Đã tạo thành công ${sb.shots.length} phân cảnh mệnh đề thị giác (visual clauses)!`);
        console.log(`    File kịch bản: ${outPath}`);
        console.log(`    Bước tiếp theo:`);
        console.log(`      1. ./videogen render ${outPath}`);
        console.log(`      2. ./videogen voice ${outPath}`);
        console.log(`      3. ./videogen assemble ${outPath}`);
        break;
      }

      case 'render': {
        const sbArg = args[1];
        if (!sbArg) {
          console.error('[!] Vui lòng cung cấp đường dẫn storyboard: ./videogen render <storyboard.json> [shots...] [--720p]');
          process.exit(1);
        }
        await bridge.ensureBridge();
        const { data: sb } = loadStoryboard(sbArg);
        const is720p = args.includes('--720p');
        const resolution = is720p ? '720p' : ((sb.project && sb.project.resolution) || '1080p');
        const targetShots = args.slice(2).filter(a => !a.startsWith('--'));

        await flow.renderStoryboard(sb, { resolution, targetShots, sbPath: sbArg });
        break;
      }

      case 'voice': {
        const sbArg = args[1];
        if (!sbArg) {
          console.error('[!] Vui lòng cung cấp đường dẫn storyboard: ./videogen voice <storyboard.json> [shots...]');
          process.exit(1);
        }
        const { data: sb } = loadStoryboard(sbArg);
        const provider = (sb && sb.voice && sb.voice.provider) || (sb && sb.tts_provider) || process.env.TTS_PROVIDER || 'vieneu';
        if (provider.toLowerCase() === 'elevenlabs') {
          await bridge.ensureBridge();
        }
        const targetShots = args.slice(2);
        await tts.generateAllVoices(sb, targetShots, sbArg);
        break;
      }

      case 'subs': {
        const sbArg = args[1];
        if (!sbArg) {
          console.error('[!] Vui lòng cung cấp đường dẫn storyboard: ./videogen subs <storyboard.json>');
          process.exit(1);
        }
        const { data: sb } = loadStoryboard(sbArg);
        const shots = sb.shots || [];

        const baseName = path.basename(sbArg, '.json');
        const episodeName = sb.series_id || (sb.project && sb.project.id ? sb.project.id : '') || baseName;
        let epRenderDir = path.join(config.RENDERS_DIR, episodeName);
        let audioDir = path.join(config.AUDIO_DIR, episodeName);
        if (!fs.existsSync(audioDir) && fs.existsSync(path.join(config.AUDIO_DIR, baseName))) {
          audioDir = path.join(config.AUDIO_DIR, baseName);
        }

        // Build timelines from existing render files (checking episode folder first) or default 10s
        const timelines = shots.map((s, idx) => {
          const shotId = s.id || `shot_${String(idx + 1).padStart(2, '0')}`;
          let renderPath = path.join(epRenderDir, `${shotId}.mp4`);
          if (!fs.existsSync(renderPath)) {
            renderPath = path.join(config.RENDERS_DIR, `${shotId}.mp4`);
          }
          const dur = fs.existsSync(renderPath) ? compositor.getDuration(renderPath) : (s.duration_seconds || 10.0);
          const aFile = path.join(audioDir, `voice_${shotId}.mp3`);
          const audioDur = fs.existsSync(aFile) ? compositor.getDuration(aFile) : 0;
          return { shotId, duration: dur, audioDuration: audioDur };
        });

        const outAss = path.join(config.RENDERS_DIR, 'subtitles.ass');
        subtitles.generateSubtitles(sb, timelines, outAss);

        // Also duplicate to episode directory if it exists
        if (fs.existsSync(epRenderDir)) {
          const epAss = path.join(epRenderDir, 'subtitles.ass');
          const epSrt = path.join(epRenderDir, 'subtitles.srt');
          fs.copyFileSync(outAss, epAss);
          const rootSrt = path.join(config.RENDERS_DIR, 'subtitles.srt');
          if (fs.existsSync(rootSrt)) {
            fs.copyFileSync(rootSrt, epSrt);
          }
        }
        break;
      }

      case 'assemble': {
        const sbArg = args[1];
        if (!sbArg) {
          console.error('[!] Vui lòng cung cấp đường dẫn storyboard: ./videogen assemble <storyboard.json> [--no-subs]');
          process.exit(1);
        }
        const noSubsFlag = args.includes('--no-subs') || args.includes('--no-sub');
        const { data: sb } = loadStoryboard(sbArg);

        await compositor.assembleStoryboard(sb, { noSubs: noSubsFlag, sbPath: sbArg });
        break;
      }

      case 'verify': {
        const target = args[1];

        if (target === '--shots' || target === 'shots') {
          console.log(`[-] Bắt đầu kiểm định chất lượng toàn bộ video clips trong renders/...`);
          const results = compositor.verifyRenderedShots();
          let passCount = 0;
          for (const r of results) {
            if (r.verified) {
              passCount++;
              console.log(`  [QA PASS] ${r.shotId}: ${r.sizeMb} MB -> ${r.snapshot}`);
            } else {
              console.warn(`  [QA WARN] ${r.shotId}: ${r.error || 'snapshot failed'}`);
            }
          }
          console.log(`\n[✓] Hoàn tất kiểm định: ${passCount}/${results.length} clips đạt chuẩn QA.`);
          break;
        }

        let videoPath = target;
        if (!videoPath || !fs.existsSync(videoPath)) {
          // Tự động tìm video master gần nhất trong output/
          const masters = fs.readdirSync(config.OUTPUT_DIR)
            .filter(f => f.endsWith('.mp4'))
            .map(f => path.join(config.OUTPUT_DIR, f))
            .sort((a, b) => fs.statSync(b).mtime.getTime() - fs.statSync(a).mtime.getTime());

          if (masters.length > 0) {
            videoPath = masters[0];
            console.log(`[-] Tự động chọn video master mới nhất: ${videoPath}`);
          } else {
            console.error('[!] Vui lòng cung cấp đường dẫn video hoặc cờ --shots:');
            console.error('    ./videogen verify <video_file> [timestamps...]');
            console.error('    ./videogen verify --shots');
            process.exit(1);
          }
        }

        const timestamps = args.slice(2).length > 0 ? args.slice(2) : ['00:00:05', '00:01:00', '00:02:00', '00:03:00', '00:04:00'];
        const verifyDir = path.join(config.RENDERS_DIR, 'verification_frames');
        console.log(`[-] Trích xuất ${timestamps.length} khung hình kiểm định từ: ${videoPath}`);
        const frames = compositor.extractVerificationFrames(videoPath, timestamps, verifyDir);
        for (const f of frames) {
          console.log(`  [✓] ${f.timestamp} -> ${f.path}`);
        }
        break;
      }

      case 'shorts': {
        const sbArg = args[1];
        if (!sbArg) {
          console.error('[!] Vui lòng cung cấp storyboard: ./videogen shorts <storyboard.json> [master_video_path]');
          process.exit(1);
        }
        const { data: sb } = loadStoryboard(sbArg);
        
        let masterVideo = args[2];
        if (!masterVideo) {
          // Find latest master in output/ or DEST_FINAL
          const outFiles = fs.existsSync(config.OUTPUT_DIR)
            ? fs.readdirSync(config.OUTPUT_DIR).filter(f => f.endsWith('.mp4')).map(f => path.join(config.OUTPUT_DIR, f))
            : [];
          if (outFiles.length > 0) {
            masterVideo = outFiles[0];
          } else if (config.DEST_FINAL && fs.existsSync(config.DEST_FINAL)) {
            const destFiles = fs.readdirSync(config.DEST_FINAL).filter(f => f.endsWith('.mp4')).map(f => path.join(config.DEST_FINAL, f));
            if (destFiles.length > 0) masterVideo = destFiles[0];
          }
        }

        if (!masterVideo || !fs.existsSync(masterVideo)) {
          console.error('[!] Không tìm thấy master video để cắt Shorts. Vui lòng truyền đường dẫn trực tiếp:');
          console.error('    ./videogen shorts storyboards/my_ep01.json /path/to/master.mp4');
          process.exit(1);
        }

        await shorts.generateAllShorts({
          storyboard: sb,
          masterVideoPath: masterVideo
        });
        break;
      }

      case 'tiktok': {
        const targetArg = args[1];
        if (!targetArg) {
          console.error('[!] Vui lòng cung cấp đường dẫn video hoặc storyboard: ./videogen tiktok <storyboard.json | video.mp4> [thumbnail.jpg] ["caption"] [--schedule "DD/MM/YYYY HH:mm"]');
          process.exit(1);
        }
        await bridge.ensureBridge();

        let scheduleArg = null;
        const schedIdx = args.findIndex(a => a === '--schedule' || a === '-s');
        if (schedIdx !== -1 && args[schedIdx + 1]) {
          scheduleArg = args[schedIdx + 1];
          args.splice(schedIdx, 2);
        }

        let videoArg = targetArg;
        let storyboardPath = null;
        let autoCaption = null;

        if (targetArg.endsWith('.json')) {
          storyboardPath = targetArg;
          const { data: sb } = loadStoryboard(targetArg);
          const baseName = path.basename(targetArg, '.json');
          const episodeName = sb.series_id || (sb.project && sb.project.id ? sb.project.id : '') || baseName;
          const candidateMaster = path.join(config.OUTPUT_DIR, `${episodeName}_master_1080p.mp4`);
          if (fs.existsSync(candidateMaster)) {
            videoArg = candidateMaster;
          }
          autoCaption = sb.tiktok?.caption || (sb.youtube ? `${sb.youtube.title}\n\n#Shorts #Viral` : sb.episode_title);
          scheduleArg = scheduleArg || sb.tiktok?.schedule || sb.schedule || null;
        }

        const thumbArg = args[2] && (args[2].endsWith('.jpg') || args[2].endsWith('.png') || args[2].endsWith('.jpeg')) ? args[2] : null;
        const captionArg = thumbArg ? args.slice(3).join(' ') : (args.length > 2 ? args.slice(2).join(' ') : autoCaption);

        await tiktok.uploadSingleShortToTikTok({
          videoPath: videoArg,
          thumbnailPath: thumbArg,
          caption: captionArg || path.basename(videoArg, path.extname(videoArg)),
          storyboardPath,
          scheduleTime: scheduleArg
        });
        break;
      }

      case 'thumb':
      case 'thumbnail': {
        const isVertical = args.includes('--vertical') || args.includes('-v') || args.includes('--shorts') || args.includes('9:16');
        const filteredArgs = args.filter(a => !['--vertical', '-v', '--shorts', '9:16'].includes(a));
        const target = filteredArgs[1];
        if (!target) {
          console.error('[!] Vui lòng cung cấp storyboard hoặc câu prompt:');
          console.error('    ./videogen thumb storyboards/my_series_ep01.json [--vertical]');
          console.error('    ./videogen thumb "Anime key visual..." [--vertical]');
          process.exit(1);
        }
        await bridge.ensureBridge();

        let sb = null;
        let customPrompt = null;
        const potentialJson = target.endsWith('.json') || fs.existsSync(target) || fs.existsSync(path.join(config.STORYBOARDS_DIR, target)) || fs.existsSync(path.join(config.STORYBOARDS_DIR, target + '.json'));

        if (potentialJson) {
          const res = loadStoryboard(target);
          sb = res.data;
          customPrompt = filteredArgs.slice(2).join(' ') || null;
        } else {
          customPrompt = filteredArgs.slice(1).join(' ');
        }

        console.log(`=== BẮT ĐẦU TẠO 4 THUMBNAIL (${isVertical ? '9:16 VERTICAL' : '16:9 WIDESCREEN'}) BẰNG NANO BANANA PRO ===`);
        await thumbnail.generateThumbnails({
          storyboard: sb,
          prompt: customPrompt,
          isVertical
        });
        break;
      }

      case 'archive': {
        const sbArg = args[1];
        const { path: sbPath } = loadStoryboard(sbArg || 'storyboards/example_anime_series.json');
        const latestMaster = fs.readdirSync(config.OUTPUT_DIR)
          .filter(f => f.endsWith('.mp4'))
          .map(f => path.join(config.OUTPUT_DIR, f))[0] || null;

        await archive.archiveProject({
          storyboardPath: sbPath,
          masterVideoPath: latestMaster,
          videoClipsDir: config.RENDERS_DIR,
          audioDir: config.AUDIO_DIR,
          assSubtitlePath: path.join(config.RENDERS_DIR, 'master_subtitles.ass')
        });
        break;
      }

      case 'upload': {
        const sbArg = args[1];
        if (sbArg === 'status') {
          await youtube.getStatus();
          break;
        }
        const { data: sb } = loadStoryboard(sbArg || 'storyboards/example_anime_series.json');
        
        const baseName = path.basename(sbArg || '', '.json');
        const episodeName = sb.series_id || (sb.project && sb.project.id ? sb.project.id : '') || baseName;
        let latestMaster = path.join(config.OUTPUT_DIR, `${episodeName}_master_1080p.mp4`);
        if (!fs.existsSync(latestMaster)) {
          const mp4s = fs.readdirSync(config.OUTPUT_DIR)
            .filter(f => f.endsWith('.mp4'))
            .map(f => ({ path: path.join(config.OUTPUT_DIR, f), mtime: fs.statSync(path.join(config.OUTPUT_DIR, f)).mtimeMs }))
            .sort((a, b) => b.mtime - a.mtime);
          if (mp4s.length > 0) latestMaster = mp4s[0].path;
        }

        if (!latestMaster || !fs.existsSync(latestMaster)) {
          console.error('[!] Không tìm thấy video thành phẩm trong output/ để tải lên!');
          process.exit(1);
        }

        const yt = sb.youtube || {};
        const title = yt.title || (sb.project && sb.project.title) || (sb.series_title ? `${sb.series_title} - ${sb.episode_title}` : sb.title) || 'Video Project';
        const desc = yt.description || (sb.project && sb.project.series) || 'Original AI Video Production';
        const schedIdx = args.indexOf('--schedule');
        const schedArg = schedIdx !== -1 && args[schedIdx + 1] ? args[schedIdx + 1] : (yt.schedule || sb.schedule || null);
        const visibility = schedArg ? 'scheduled' : (yt.visibility || 'unlisted');
        const channelIdx = args.indexOf('--channel');
        const channelArg = channelIdx !== -1 && args[channelIdx + 1] ? args[channelIdx + 1] : (yt.channel_id || yt.channel || sb.channel || null);

        await youtube.uploadVideo({
          videoPath: latestMaster,
          title,
          description: desc,
          visibility,
          schedule: schedArg,
          channel: channelArg
        });
        break;
      }

      case 'facebook': {
        const isDraft = args.includes('--draft');
        const schedIdx = args.indexOf('--schedule');
        let scheduleVal = null;
        if (schedIdx !== -1 && args[schedIdx + 1] && !args[schedIdx + 1].startsWith('--')) {
          scheduleVal = args[schedIdx + 1];
        }

        const nonFlagArgs = args.filter((a, idx) => {
          if (a === '--draft') return false;
          if (a === '--schedule') return false;
          if (schedIdx !== -1 && idx === schedIdx + 1) return false;
          return true;
        });
        const sbArg = nonFlagArgs[1];

        if (!sbArg) {
          console.error('[!] Vui lòng cung cấp storyboard hoặc lệnh: ./videogen facebook <storyboard.json> [video_file] [--draft]');
          process.exit(1);
        }

        if (sbArg === 'status') {
          await facebook.getStatus();
          break;
        }

        await bridge.ensureBridge();

        const { data: sb } = loadStoryboard(sbArg);
        const explicitVideo = nonFlagArgs[2] || null;

        let videoToUpload = explicitVideo;
        if (videoToUpload && !fs.existsSync(videoToUpload)) {
          console.error(`[!] Không tìm thấy file video chỉ định tại: ${videoToUpload}`);
          process.exit(1);
        }

        if (!videoToUpload) {
          const baseName = path.basename(sbArg, '.json');
          const episodeName = sb.series_id || (sb.project && sb.project.id ? sb.project.id : '') || baseName;
          const candidates = [
            path.join(config.OUTPUT_DIR, `${episodeName}_master_1080p.mp4`),
            path.join(config.OUTPUT_DIR, `${episodeName}_master_720p.mp4`),
            path.join(config.OUTPUT_DIR, `${baseName}_master_1080p.mp4`),
            path.join(config.OUTPUT_DIR, `${baseName}.mp4`)
          ];
          for (const c of candidates) {
            if (fs.existsSync(c)) {
              videoToUpload = c;
              break;
            }
          }

          if (!videoToUpload) {
            const mp4s = fs.readdirSync(config.OUTPUT_DIR)
              .filter(f => f.endsWith('.mp4'))
              .map(f => ({ path: path.join(config.OUTPUT_DIR, f), mtime: fs.statSync(path.join(config.OUTPUT_DIR, f)).mtimeMs }))
              .sort((a, b) => b.mtime - a.mtime);
            if (mp4s.length > 0) videoToUpload = mp4s[0].path;
          }
        }

        if (!videoToUpload || !fs.existsSync(videoToUpload)) {
          console.error('[!] Không tìm thấy file video phù hợp để đăng lên Facebook Reels!');
          console.error('    Vui lòng cung cấp đường dẫn: ./videogen facebook <storyboard.json> <video_path>');
          process.exit(1);
        }

        await facebook.uploadReel({
          videoPath: videoToUpload,
          draft: isDraft,
          schedule: scheduleVal,
          storyboard: sb
        });
        break;
      }

      case 'run': {
        const sbArg = args[1];
        if (!sbArg) {
          console.error('[!] Vui lòng cung cấp đường dẫn storyboard: ./videogen run <storyboard.json> [--720p] [--draft] [--no-upload] [--skip-render] [--skip-voice]');
          process.exit(1);
        }

        const isDraft = args.includes('--draft');
        const noUpload = args.includes('--no-upload') || args.includes('--no-up');
        const skipRender = args.includes('--skip-render') || args.includes('--no-render');
        const skipVoice = args.includes('--skip-voice') || args.includes('--no-voice');
        const is720p = args.includes('--720p');
        const resolution = is720p ? '720p' : '1080p';
        const platformArg = args.find(a => a.startsWith('--platform='));
        const targetPlatform = platformArg ? platformArg.split('=')[1] : 'all';

        if (!skipRender || !skipVoice || !noUpload) {
          await bridge.ensureBridge();
        }

        await pipelineLoop.runPipelineForStoryboard(sbArg, {
          draft: isDraft,
          noUpload,
          skipRender,
          skipVoice,
          resolution,
          targetPlatform
        });
        break;
      }

      case 'loop': {
        const isDraft = args.includes('--draft');
        const noUpload = args.includes('--no-upload') || args.includes('--no-up');
        const skipRender = args.includes('--skip-render') || args.includes('--no-render');
        const skipVoice = args.includes('--skip-voice') || args.includes('--no-voice');
        const is720p = args.includes('--720p');
        const resolution = is720p ? '720p' : '1080p';
        const platformArg = args.find(a => a.startsWith('--platform='));
        const targetPlatform = platformArg ? platformArg.split('=')[1] : 'all';

        // Storyboard paths are non-flag arguments after 'loop'
        const sbArgs = args.slice(1).filter(a => !a.startsWith('--'));

        if (!skipRender || !skipVoice || !noUpload) {
          await bridge.ensureBridge();
        }

        await pipelineLoop.runLoop(sbArgs, {
          draft: isDraft,
          noUpload,
          skipRender,
          skipVoice,
          resolution,
          targetPlatform
        });
        break;
      }

      default:
        console.error(`[!] Lệnh không xác định: "${command}". Chạy ./videogen help để xem hướng dẫn.`);
        process.exit(1);
    }
  } catch (err) {
    console.error(`\n[!] LỖI THỰC THI:`, err.message);
    process.exit(1);
  }
}

main();
