#!/bin/sh
# VideoGen Pre-Commit Security Guard (SEC-02 & SEC-03 Hardened)
# Automatically blocks commits containing private channel IDs, custom private tokens, or credentials.

printf '%s\n' "🔍 [Pre-Commit Guard] Đang quét toàn bộ file staged kiểm tra rò rỉ dữ liệu..."

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)

# Structural pattern for YouTube Channel IDs (UC[a-zA-Z0-9_-]{22})
PATTERN="(^|[^a-zA-Z0-9_-])UC[a-zA-Z0-9_-]{22}($|[^a-zA-Z0-9_-])"

# Load custom private tokens from local gitignored .env if defined
if [ -f "$REPO_ROOT/.env" ]; then
  EXTRA_TOKENS=$(grep -E '^(ZERO_LEAK_BLOCKLIST|PRIVATE_BLOCKLIST|LEAK_BLOCKLIST|YOUTUBE_CHANNEL_ID|TYPESAFE_API_KEY)=' "$REPO_ROOT/.env" 2>/dev/null \
    | sed -E "s/^[A-Z0-9_]+=//; s/^['\"]//; s/['\"]$//" \
    | tr ',' '|' \
    | tr '\n' '|' \
    | sed -E 's/\|+/|/g; s/^\|//; s/\|$//')
  if [ -n "$EXTRA_TOKENS" ]; then
    PATTERN=$(printf '%s|%s' "$PATTERN" "$EXTRA_TOKENS")
  fi
fi

# Safe null-terminated iteration over staged files (does not blind-skip .env.example)
git diff --cached --name-only -z | xargs -0 sh -c '
  PATTERN=$1
  shift
  LEAKS=""

  for file in "$@"; do
    [ -z "$file" ] && continue

    # Block direct commits of private .env, private storyboards, or rendered media
    case "$file" in
      .env|*.env)
        if [ "$file" != ".env.example" ]; then
          printf "  [✗] File bảo mật bị cấm commit trực tiếp: %s\n" "$file"
          LEAKS="yes"
          continue
        fi
        ;;
      storyboards/*.json)
        printf "  [✗] Kịch bản riêng tư bị cấm commit: %s\n" "$file"
        LEAKS="yes"
        continue
        ;;
      renders/*)
        case "$file" in
          *.gitkeep) ;;
          *)
            printf "  [✗] File render bị cấm commit: %s\n" "$file"
            LEAKS="yes"
            continue
            ;;
        esac
        ;;
    esac

    # Skip only the guard script itself
    if [ "$file" = ".githooks/pre-commit" ]; then
      continue
    fi

    FILE_DIFF=$(git diff --cached -- "$file" | grep -E "^\+[^+]" | grep -iE "$PATTERN")
    if [ -n "$FILE_DIFF" ]; then
      printf "  [✗] Vi phạm trong %s:\n" "$file"
      printf "%s\n" "$FILE_DIFF"
      LEAKS="yes"
    fi
  done

  if [ -n "$LEAKS" ]; then
    printf "\n%s\n" "❌ [BLOCK] PHÁT HIỆN DỮ LIỆU NỘI BỘ TRONG COMMIT!"
    printf "%s\n" "👉 Vui lòng loại bỏ Channel ID, tên kênh riêng tư hoặc thông tin nhạy cảm trước khi commit."
    exit 1
  fi
' sh "$PATTERN" || exit 1

printf '%s\n' "✅ [Pre-Commit Guard] Kiểm tra hoàn tất: Toàn bộ code staged đạt chuẩn Zero-Leak!"
exit 0

