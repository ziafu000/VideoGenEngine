# ==============================================================================
# VIDEOGEN ENGINE v2.0 - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and adjust variables to match your environment.
# All variables are optional with sensible auto-detected defaults.

# ------------------------------------------------------------------------------
# 1. Chrome DevTools Protocol (CDP) Bridge
# ------------------------------------------------------------------------------
# The Windows host IP address where Chrome remote debugging is accessible from WSL.
# If left blank, VideoGen auto-detects the host IP from the default routing table.
# WIN_HOST=192.168.1.100

# The CDP port where the Node proxy or Chrome remote debugging listens (default: 9223).
# CDP_PORT=9223

# ------------------------------------------------------------------------------
# 2. Local & Windows File System Directories
# ------------------------------------------------------------------------------
# Path to Windows user Downloads directory (where Chrome saves downloaded clips/voices).
# Default: /mnt/c/Users/<Username>/Downloads
# WIN_DOWNLOADS_DIR=/mnt/c/Users/YourWindowsUsername/Downloads

# External long-term archival destination for original raw materials (clips, voices).
# DEST_ORIGINAL=/mnt/d/Workspace/VideoGen/Original

# External long-term archival destination for final edited master videos.
# DEST_FINAL=/mnt/d/Workspace/VideoGen/Final

# YouTube Studio Channel ID or custom dashboard URL (optional)
# YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 3. Video Resolution Defaults
# ------------------------------------------------------------------------------
# Default download resolution from Google Flow: "1080p" (Cloud Super-Resolution)
# or "720p" (Direct fast CDN download).
# VIDEOGEN_RESOLUTION=1080p

# ------------------------------------------------------------------------------
# 4. TypeSafe AI (System One Jev)
# ------------------------------------------------------------------------------
# API Key for TypeSafe Jev System One semantic browser decisions.
# Can also be set in ~/.bashrc or your system environment.
# TYPESAFE_API_KEY=your-typesafe-api-key-here
